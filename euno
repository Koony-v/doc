function newStmtCareerRow(){ return { id:'sc_'+Math.random().toString(36).slice(2,9), periodStart:'', periodEnd:'', isCurrent:false, businessType:'', workplace:'', position:'', natureType:'근무' }; }
function newStmtMarriageRow(){ return { id:'sm_'+Math.random().toString(36).slice(2,9), date:'', spouseName:'', type:'혼인' }; }
function newStmtLegalActionRow(){ return { id:'sl_'+Math.random().toString(36).slice(2,9), detail:'', creditor:'', court:'', caseNumber:'' }; }

function renderStatement(){
  const st = state.statement;

  document.getElementById('stmtEduDate').value = fmtDateInputDisplay(st.finalEducation.date);
  document.getElementById('stmtEduStatus').value = st.finalEducation.status;

  renderStmtCareer();
  renderStmtMarriage();

  document.getElementById('stmtHousingStart').value = fmtDateInputDisplay(st.housing.startDate);
  document.getElementById('stmtHousingType').value = st.housing.type;
  document.getElementById('stmtLeaseDeposit').value = moneyInputDisplay(st.housing.leaseDeposit);
  document.getElementById('stmtLeaseRent').value = moneyInputDisplay(st.housing.leaseRent);
  document.getElementById('stmtLeaseOverdue').value = moneyInputDisplay(st.housing.leaseOverdue);
  document.getElementById('stmtLeaseTenantName').value = st.housing.leaseTenantName;
  document.getElementById('stmtRelativeOwnerName').value = st.housing.relativeOwnerName;
  document.getElementById('stmtNonRelativeRelation').value = st.housing.nonRelativeRelation;
  document.getElementById('stmtHousingOtherText').value = st.housing.otherText;
  updateStmtHousingFieldsVisibility();

  document.querySelectorAll('#stmtLegalActionToggle button').forEach(b => b.classList.toggle('active', b.dataset.val === String(st.hasLegalAction)));
  document.getElementById('stmtLegalActionFields').style.display = st.hasLegalAction ? 'block' : 'none';
  renderStmtLegalAction();

  Object.keys(st.reasonChecks).forEach(k => {
    const el = document.getElementById('stmtReason_'+k);
    if(el) el.checked = st.reasonChecks[k];
  });
  document.getElementById('stmtReasonEtc').value = st.reasonEtc;
  document.getElementById('stmtDetailedStatement').value = st.detailedStatement;

  ['bankruptcy','rehabilitation','workout','badBank'].forEach(key => {
    const p = st.pastProcedures[key];
    const cb = document.getElementById('stmtProc_'+key+'_checked');
    if(cb) cb.checked = p.checked;
    const courtEl = document.getElementById('stmtProc_'+key+'_court');
    if(courtEl) courtEl.value = p.court;
    const dateEl = document.getElementById('stmtProc_'+key+'_date');
    if(dateEl) dateEl.value = fmtDateInputDisplay(p.date);
    if(key === 'workout'){
      document.getElementById('stmtProc_workout_count').value = p.count;
      document.getElementById('stmtProc_workout_amount').value = moneyInputDisplay(p.amount);
    } else {
      const progEl = document.getElementById('stmtProc_'+key+'_progress');
      if(progEl) progEl.value = p.progress;
    }
  });
}

function updateStmtHousingFieldsVisibility(){
  const type = state.statement.housing.type;
  document.getElementById('stmtHousingLeaseFields').style.display = type === 'lease' ? 'grid' : 'none';
  document.getElementById('stmtHousingRelativeFields').style.display = type === 'relativeOwned' ? 'grid' : 'none';
  document.getElementById('stmtHousingNonRelativeFields').style.display = type === 'nonRelativeOwned' ? 'grid' : 'none';
  document.getElementById('stmtHousingOtherFields').style.display = type === 'other' ? 'grid' : 'none';
}

