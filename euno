function bindStatement(){
  document.getElementById('panel-statement').addEventListener('keydown', e => {
    if(e.key !== 'Enter') return;
    if(e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT'){
      e.preventDefault();
      e.target.blur();
    }
  });

  document.getElementById('stmtEduDate').addEventListener('change', e => {
    const raw = e.target.value.trim();
    if(!raw){ state.statement.finalEducation.date=''; e.target.classList.remove('date-error'); save(); return; }
    const parsed = parseFlexibleDate(raw);
    if(parsed===null){ e.target.classList.add('date-error'); save(); return; }
    state.statement.finalEducation.date = parsed;
    e.target.value = fmtDateInputDisplay(parsed);
    e.target.classList.remove('date-error');
    save();
  });
  document.getElementById('stmtEduStatus').addEventListener('change', e => { state.statement.finalEducation.status = e.target.value; save(); });

  document.getElementById('btnAddStmtCareer').addEventListener('click', () => {
    state.statement.pastCareers.push(newStmtCareerRow());
    renderStmtCareer();
    save();
  });
  document.getElementById('stmtCareerBody').addEventListener('input', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id || !field) return;
    const row = state.statement.pastCareers.find(r => r.id === id);
    if(!row) return;
    if(field === 'isCurrent'){
      row.isCurrent = t.checked;
      renderStmtCareer();
    } else {
      row[field] = t.value;
    }
    save();
  });
  document.getElementById('stmtCareerBody').addEventListener('change', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id) return;
    const row = state.statement.pastCareers.find(r => r.id === id);
    if(!row) return;
    if(field === 'periodStart' || field === 'periodEnd'){
      const raw = t.value.trim();
      if(!raw){ row[field]=''; t.classList.remove('date-error'); save(); return; }
      const parsed = parseFlexibleDate(raw);
      if(parsed===null){ t.classList.add('date-error'); save(); return; }
      row[field] = parsed;
      t.value = fmtDateInputDisplay(parsed);
      t.classList.remove('date-error');
      save();
      return;
    }
    if(t.tagName !== 'SELECT') return;
    row.natureType = t.value;
    save();
  });
  document.getElementById('stmtCareerBody').addEventListener('click', e => {
    const btn = e.target.closest('.del-row');
    if(!btn) return;
    state.statement.pastCareers = state.statement.pastCareers.filter(r => r.id !== btn.dataset.id);
    renderStmtCareer();
    save();
  });

  document.getElementById('btnAddStmtMarriage').addEventListener('click', () => {
    state.statement.pastMarriageEvents.push(newStmtMarriageRow());
    renderStmtMarriage();
    save();
  });
  document.getElementById('stmtMarriageBody').addEventListener('input', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id || !field) return;
    const row = state.statement.pastMarriageEvents.find(r => r.id === id);
    if(!row) return;
    if(field !== 'date') row[field] = t.value;
    save();
  });
  document.getElementById('stmtMarriageBody').addEventListener('change', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id) return;
    const row = state.statement.pastMarriageEvents.find(r => r.id === id);
    if(!row) return;
    if(field === 'date'){
      const raw = t.value.trim();
      if(!raw){ row.date=''; t.classList.remove('date-error'); save(); return; }
      const parsed = parseFlexibleDate(raw);
      if(parsed===null){ t.classList.add('date-error'); save(); return; }
      row.date = parsed;
      t.value = fmtDateInputDisplay(parsed);
      t.classList.remove('date-error');
      save();
      return;
    }
    if(t.tagName !== 'SELECT') return;
    row.type = t.value;
    save();
  });
  document.getElementById('stmtMarriageBody').addEventListener('click', e => {
    const btn = e.target.closest('.del-row');
    if(!btn) return;
    state.statement.pastMarriageEvents = state.statement.pastMarriageEvents.filter(r => r.id !== btn.dataset.id);
    renderStmtMarriage();
    save();
  });

  document.getElementById('stmtHousingStart').addEventListener('change', e => {
    const raw = e.target.value.trim();
    if(!raw){ state.statement.housing.startDate=''; e.target.classList.remove('date-error'); save(); return; }
    const parsed = parseFlexibleDate(raw);
    if(parsed===null){ e.target.classList.add('date-error'); save(); return; }
    state.statement.housing.startDate = parsed;
    e.target.value = fmtDateInputDisplay(parsed);
    e.target.classList.remove('date-error');
    save();
  });
  document.getElementById('stmtHousingType').addEventListener('change', e => {
    state.statement.housing.type = e.target.value;
    updateStmtHousingFieldsVisibility();
    save();
  });
  [['stmtLeaseDeposit','leaseDeposit'],['stmtLeaseRent','leaseRent'],['stmtLeaseOverdue','leaseOverdue']].forEach(([id,key]) => {
    document.getElementById(id).addEventListener('input', e => {
      state.statement.housing[key] = liveFormatMoney(e.target);
      save();
    });
  });
  [['stmtLeaseTenantName','leaseTenantName'],['stmtRelativeOwnerName','relativeOwnerName'],['stmtNonRelativeRelation','nonRelativeRelation'],['stmtHousingOtherText','otherText']].forEach(([id,key]) => {
    document.getElementById(id).addEventListener('input', e => {
      state.statement.housing[key] = e.target.value;
      save();
    });
  });

  document.getElementById('stmtLegalActionToggle').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if(!btn) return;
    state.statement.hasLegalAction = btn.dataset.val === 'true';
    document.querySelectorAll('#stmtLegalActionToggle button').forEach(b => b.classList.toggle('active', b === btn));
    document.getElementById('stmtLegalActionFields').style.display = state.statement.hasLegalAction ? 'block' : 'none';
    save();
  });
  document.getElementById('btnAddStmtLegalAction').addEventListener('click', () => {
    state.statement.legalActionRows.push(newStmtLegalActionRow());
    renderStmtLegalAction();
    save();
  });
  document.getElementById('stmtLegalActionBody').addEventListener('input', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id || !field) return;
    const row = state.statement.legalActionRows.find(r => r.id === id);
    if(!row) return;
    row[field] = t.value;
    save();
  });
  document.getElementById('stmtLegalActionBody').addEventListener('click', e => {
    const btn = e.target.closest('.del-row');
    if(!btn) return;
    state.statement.legalActionRows = state.statement.legalActionRows.filter(r => r.id !== btn.dataset.id);
    renderStmtLegalAction();
    save();
  });

  Object.keys(state.statement.reasonChecks).forEach(k => {
    document.getElementById('stmtReason_'+k).addEventListener('change', e => {
      state.statement.reasonChecks[k] = e.target.checked;
      save();
    });
  });
  document.getElementById('stmtReasonEtc').addEventListener('input', e => { state.statement.reasonEtc = e.target.value; save(); });
  document.getElementById('stmtDetailedStatement').addEventListener('input', e => { state.statement.detailedStatement = e.target.value; save(); });

  ['bankruptcy','rehabilitation','workout','badBank'].forEach(key => {
    document.getElementById('stmtProc_'+key+'_checked').addEventListener('change', e => { state.statement.pastProcedures[key].checked = e.target.checked; save(); });
    document.getElementById('stmtProc_'+key+'_court').addEventListener('input', e => { state.statement.pastProcedures[key].court = e.target.value; save(); });
    document.getElementById('stmtProc_'+key+'_date').addEventListener('change', e => {
      const p = state.statement.pastProcedures[key];
      const raw = e.target.value.trim();
      if(!raw){ p.date=''; e.target.classList.remove('date-error'); save(); return; }
      const parsed = parseFlexibleDate(raw);
      if(parsed===null){ e.target.classList.add('date-error'); save(); return; }
      p.date = parsed;
      e.target.value = fmtDateInputDisplay(parsed);
      e.target.classList.remove('date-error');
      save();
    });
    if(key === 'workout'){
      document.getElementById('stmtProc_workout_count').addEventListener('input', e => {
        state.statement.pastProcedures.workout.count = e.target.value.replace(/[^\d]/g,'');
        e.target.value = state.statement.pastProcedures.workout.count;
        save();
      });
      document.getElementById('stmtProc_workout_amount').addEventListener('input', e => {
        state.statement.pastProcedures.workout.amount = liveFormatMoney(e.target);
        save();
      });
    } else {
      document.getElementById('stmtProc_'+key+'_progress').addEventListener('input', e => { state.statement.pastProcedures[key].progress = e.target.value; save(); });
    }
  });

  document.getElementById('btnPrintStatement').addEventListener('click', printStatement);
}

function printStatement(){
  const st = state.statement;

  const careerList = st.pastCareers.length ? st.pastCareers : [null];
  const careerHtml = careerList.map(r => {
    if(!r) return `<tr><td colspan="2" style="text-align:center;color:#888;">기재사항 없음</td></tr>`;
    const periodText = `${fmtDateDot(r.periodStart)||'-'} 부터 ${r.isCurrent ? '현재' : (fmtDateDot(r.periodEnd)||'-')} 까지`;
    return `
    <tr>
      <th style="width:18%;">기간</th>
      <td colspan="2">${periodText}</td>
      <th style="width:14%;">구분</th>
      <td style="width:14%;text-align:center;">(${r.natureType})</td>
    </tr>
    <tr>
      <th>업종</th>
      <td>${escapeHtml(r.businessType)||'-'}</td>
      <th>직장명</th>
      <td colspan="2">${escapeHtml(r.workplace)||'-'} <span style="margin-left:10px;color:#555;">직위: ${escapeHtml(r.position)||'-'}</span></td>
    </tr>`;
  }).join('');

  const marriageList = st.pastMarriageEvents.length ? st.pastMarriageEvents : [null];
  const marriageHtml = marriageList.map(r => {
    if(!r) return `<tr><td colspan="3" style="text-align:center;color:#888;">해당사항 없음</td></tr>`;
    return `<tr>
      <td style="width:30%;text-align:center;">${fmtDateDot(r.date)||'-'}</td>
      <td style="width:40%;text-align:center;">${escapeHtml(r.spouseName)||'-'}</td>
      <td style="width:30%;text-align:center;">(${r.type})</td>
    </tr>`;
  }).join('');

  const housingOptions = [
    {key:'own', label:'㉠ 신청인 소유의 주택'},
    {key:'company', label:'㉡ 사택 또는 기숙사'},
    {key:'lease', label:'㉢ 임차(전·월세) 주택'},
    {key:'relativeOwned', label:'㉣ 친족 소유 주택에 무상거주'},
    {key:'nonRelativeOwned', label:'㉤ 친족 외 소유 주택에 무상거주'},
    {key:'other', label:'㉥ 기타'}
  ];
  const housingOptionsHtml = housingOptions.map(o => {
    const checked = st.housing.type === o.key;
    return `<div style="padding:4px 0;${checked?'font-weight:900;':'color:#888;'}">${checked?'☑':'⬜'} ${o.label}</div>`;
  }).join('');
  let housingDetail = '-';
  if(st.housing.type === 'lease'){
