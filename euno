function sumLinkedCreditors(row){
  return (row.linkedCreditorIds || []).reduce((s,cid) => {
    const c = state.creditors.find(x => x.id === cid);
    if(!c) return s;
    return s + (Number(c.principal)||0) + (Number(c.interest)||0);
  }, 0);
}

function sumLinkedCreditorsCapped(row){
  return (row.linkedCreditorIds || []).reduce((s,cid) => {
    const c = state.creditors.find(x => x.id === cid);
    if(!c) return s;
    const debtBalance = (Number(c.principal)||0) + (Number(c.interest)||0);
    const maxClaim = (c.hasAttachment && c.attachmentType === '1' && c.attachmentType1 && Number(c.attachmentType1.amount))
      ? Number(c.attachmentType1.amount)
      : null;
    const deduction = maxClaim ? Math.min(debtBalance, maxClaim) : debtBalance;
    return s + deduction;
  }, 0);
}

function computeLeaseCounted(row){
  const deposit = Number(row.deposit)||0;
  if(row.reasonType === '246조6호'){
    const cfg = LEASE_REGIONS[row.region] || LEASE_REGIONS['서울'];
    if(deposit <= cfg.threshold){
      const exempt = Math.min(deposit, cfg.protect);
      return Math.max(0, deposit - exempt);
    }
    return deposit;
  }
  if(row.reasonType === '반환불가'){
    return Number(row.actualReturnable)||0;
  }
  if(row.reasonType === '질권설정'){
    const pledged = (row.linkedCreditorIds||[]).reduce((s,cid) => {
      const c = state.creditors.find(x => x.id === cid);
      if(!c) return s;
      return s + (Number(c.principal)||0) + (Number(c.interest)||0);
    }, 0);
    return Math.max(0, deposit - pledged);
  }
  return deposit;
}

