function bindTable(){
  document.getElementById('debtBody').addEventListener('keydown', e => {
    if(e.key !== 'Enter') return;
    const t = e.target;
    if(!t.dataset || !t.dataset.field) return;
    e.preventDefault();
    t.blur();
  });

  document.getElementById('debtBody').addEventListener('input', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id || !field) return;
    const row = state.creditors.find(r => r.id === id);
    if(!row) return;
    row[field] = t.value;

    if(field === 'principal' || field === 'interest'){
      const raw = t.value.replace(/[^\d]/g, '');
      row[field] = raw;
      const formatted = raw ? Number(raw).toLocaleString('ko-KR') : '';
      const cursorPos = t.selectionStart;
      const prevLength = t.value.length;
      t.value = formatted;
      const newPos = Math.max(0, cursorPos + (formatted.length - prevLength));
      t.setSelectionRange(newPos, newPos);

      const total = (Number(row.principal)||0) + (Number(row.interest)||0);
      const tr = t.closest('tr');
      const cell = tr.querySelector('.total-cell');
      if(cell) cell.textContent = row.natureType === '장래구상채권' ? '미발생' : total.toLocaleString('ko-KR');
      renderSummary();
      syncAssetLinks();
    } else if(['address','zip','phone','note'].includes(field)){
      row.addrSource = 'manual';
    }
    save();
  });

  document.getElementById('debtBody').addEventListener('change', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id) return;
    const row = state.creditors.find(r => r.id === id);
    if(!row) return;

    if(field === 'claimType'){
      row.claimType = t.value;
      renderTable();
      renderSummary();
      syncAssetLinks();
      save();
      return;
    }

    if(field === 'natureType'){
      const prev = row.natureType;
      row.natureType = t.value;
      if(row.natureType === '장래구상채권'){
        row.category = '장래구상채권';
        row.principal = '';
        row.interest = '';
      } else if(row.natureType === '보증채무'){
        if(!row.category || row.category === '장래구상채권') row.category = '보증채무';
      } else if(prev === '장래구상채권' && row.category === '장래구상채권'){
        row.category = '';
      }
      renderTable();
      renderSummary();
      save();
      return;
    }

    if(field === 'baseDate' || field === 'loanDate'){
      const raw = t.value.trim();
      if(!raw){
        row[field] = '';
        t.classList.remove('date-error');
        save();
        return;
      }
      const parsed = parseFlexibleDate(raw);
      if(parsed === null){
        t.classList.add('date-error');
        t.title = '날짜 형식을 인식하지 못했습니다. 예: 26/7/24, 2026-07-24, 2026.7.24';
        save();
        return;
      }
      row[field] = parsed;
      t.value = fmtDateInputDisplay(parsed);
      t.classList.remove('date-error');
      t.title = '';
      save();
      return;
    }

    if(field !== 'name') return;
    const hit = findCreditor(t.value);
    if(hit){
      row.address = hit.address;
      row.zip = hit.zip;
      row.phone = hit.phone;
      row.note = hit.note;
      row.addrSource = 'db';
    } else {
      row.addrSource = '';
    }
    renderTable();
    syncAssetLinks();
    save();
  });

  document.getElementById('debtBody').addEventListener('click', e => {
    const delBtn = e.target.closest('.del-row');
    if(delBtn){
      const id = delBtn.dataset.id;
      state.creditors.forEach(r => { if(r.parentId === id) r.parentId = null; });
      state.creditors = state.creditors.filter(r => r.id !== id);
      if(state.creditors.length === 0) state.creditors.push(newCreditorRow());
      renderTable();
      renderSummary();
      syncAssetLinks();
      save();
      return;
    }

    const recourseBtn = e.target.closest('.add-recourse-btn');
    if(recourseBtn){
      const id = recourseBtn.dataset.id;
      const idx = state.creditors.findIndex(r => r.id === id);
      if(idx === -1) return;
      const origin = state.creditors[idx];
      const recourseRow = newCreditorRow({
        name: '',
        claimType: origin.claimType,
        natureType: '장래구상채권',
        linkedCreditor: origin.name,
        parentId: origin.id,
        category: '장래구상채권',
        principal: '',
        interest: '',
        note: `${origin.name || '원채권자'}에 대한 보증채무의 장래구상채권`
      });
      let insertAt = idx + 1;
      while(insertAt < state.creditors.length && state.creditors[insertAt].parentId === origin.id){
        insertAt++;
      }
      state.creditors.splice(insertAt, 0, recourseRow);
      renderTable();
      renderSummary();
      save();
      return;
    }
  });

  bindDragAndDrop();

  document.getElementById('btnAddRow').addEventListener('click', () => {
    state.creditors.push(newCreditorRow());
    renderTable();
    save();
  });
}

let dragState = null;

function clearDropIndicators(){
  document.querySelectorAll('#debtBody tr').forEach(tr => tr.classList.remove('drop-before','drop-after','drop-nest'));
}

function bindDragAndDrop(){
  const tbody = document.getElementById('debtBody');

  tbody.addEventListener('dragstart', e => {
    const handle = e.target.closest('.drag-handle');
    if(!handle){ e.preventDefault(); return; }
    dragState = { id: handle.dataset.id };
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', handle.dataset.id);
    const tr = handle.closest('tr');
    if(tr) tr.style.opacity = '0.4';
  });

  tbody.addEventListener('dragend', e => {
    const tr = e.target.closest('tr');
    if(tr) tr.style.opacity = '';
    clearDropIndicators();
    dragState = null;
  });

  tbody.addEventListener('dragover', e => {
    if(!dragState) return;
    e.preventDefault();
    const tr = e.target.closest('tr');
    if(!tr || tr.dataset.rowId === dragState.id) return;
    clearDropIndicators();
    const rect = tr.getBoundingClientRect();
    const relY = (e.clientY - rect.top) / rect.height;
    let zone = relY < 0.3 ? 'before' : (relY > 0.7 ? 'after' : 'nest');
    tr.dataset.dropZone = zone;
    tr.classList.add('drop-' + zone);
  });

  tbody.addEventListener('drop', e => {
    e.preventDefault();
    const tr = e.target.closest('tr');
    const zone = tr ? tr.dataset.dropZone : null;
    clearDropIndicators();
    if(!tr || !dragState) return;
    const targetId = tr.dataset.rowId;
    const draggedId = dragState.id;
    dragState = null;
    if(targetId === draggedId) return;
    handleDrop(draggedId, targetId, zone || 'before');
  });
}

function handleDrop(draggedId, targetId, zone){
  const fromIdx = state.creditors.findIndex(r => r.id === draggedId);
  if(fromIdx === -1) return;
  const dragged = state.creditors[fromIdx];

  let block = [dragged];
  let i = fromIdx + 1;
  while(i < state.creditors.length && state.creditors[i].parentId === dragged.id){
    block.push(state.creditors[i]);
    i++;
  }
  const isParentBlock = block.length > 1;

  state.creditors.splice(fromIdx, block.length);

  const targetIdx = state.creditors.findIndex(r => r.id === targetId);
  if(targetIdx === -1){
    state.creditors.splice(fromIdx, 0, ...block);
    renderTable();
    return;
  }
  const target = state.creditors[targetIdx];

  if(zone === 'nest' && !isParentBlock){
    const parentRow = target.parentId ? (state.creditors.find(r => r.id === target.parentId) || target) : target;
    dragged.parentId = parentRow.id;
    dragged.natureType = '장래구상채권';
    dragged.linkedCreditor = parentRow.name;
    dragged.category = '장래구상채권';
    dragged.principal = '';
    dragged.interest = '';
    const parentIdx = state.creditors.findIndex(r => r.id === parentRow.id);
    let insertAt = parentIdx + 1;
    while(insertAt < state.creditors.length && state.creditors[insertAt].parentId === parentRow.id){
      insertAt++;
    }
    state.creditors.splice(insertAt, 0, dragged);
  } else {
    dragged.parentId = null;
    let insertIdx = targetIdx + (zone === 'after' ? 1 : 0);
    state.creditors.splice(insertIdx, 0, ...block);
  }

  renderTable();
  renderSummary();
  save();
}

