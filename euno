function renderAssetSummary(){
  const a = state.assets;
  const depositSum = a.deposits.reduce((s,r) => s + (Number(r.balance)||0), 0);
  const depositNet = Math.max(0, depositSum - 2500000);
  document.getElementById('depositSumDisplay').textContent = moneyWon(depositSum);
  document.getElementById('depositNetDisplay').textContent = moneyWon(depositNet);

  const insuranceSum = a.insurance.reduce((s,r) => s + (Number(r.surrender)||0), 0);
  const insuranceNet = Math.max(0, insuranceSum - 2500000);
  document.getElementById('insuranceSumDisplay').textContent = moneyWon(insuranceSum);
  document.getElementById('insuranceNetDisplay').textContent = moneyWon(insuranceNet);

  const vehicleTotal = a.vehicles.reduce((s,r) => {
    const p1 = Number(r.price1)||0, p2 = Number(r.price2)||0;
    const avg = (p1 && p2) ? Math.round((p1+p2)/2) : (p1 || p2 || 0);
    return s + Math.max(0, avg - sumLinkedCreditorsCapped(r));
  }, 0);

  const realtyTotal = a.realties.reduce((s,r) => s + Math.max(0, (Number(r.expected)||0) - sumLinkedCreditorsCapped(r)), 0);
  const leaseTotal = a.leases.reduce((s,r) => s + computeLeaseCounted(r), 0);
  const equipTotal = a.equipment.reduce((s,r) => s + (Number(r.value)||0), 0);
  const otherTotal = a.others.reduce((s,r) => s + (Number(r.value)||0), 0);

  const severanceNote = document.getElementById('severanceNote');
  let severanceNet = 0;
  if(a.severance.isPension){
    severanceNet = 0;
    severanceNote.innerHTML = '퇴직연금 가입자로 표시되어 재산가치·청산가치에 반영되지 않습니다.';
  } else {
    severanceNet = Math.round((Number(a.severance.total)||0) / 2);
    severanceNote.innerHTML = `압류할 수 없는 퇴직금(1/2)은 제외되어, 재산 반영액은 총액의 절반입니다: <span id="severanceNetDisplay">${moneyWon(severanceNet)}</span>`;
  }

  const loanReceivableSum = a.loanReceivables.reduce((s,r) => s + (Number(r.amount)||0), 0);
  const salesReceivableSum = a.salesReceivables.reduce((s,r) => s + (Number(r.amount)||0), 0);

  const cash = Number(a.cash)||0;

  const total = cash + depositNet + insuranceNet + vehicleTotal + leaseTotal + realtyTotal + equipTotal + loanReceivableSum + salesReceivableSum + severanceNet + otherTotal;
  const exemption = getExemptionTotal();
  const liquidation = Math.max(0, total - exemption);

  document.getElementById('assetTotalDisplay').textContent = moneyWon(total);
  document.getElementById('exemptionDisplay').textContent = moneyWon(exemption);
  document.getElementById('liquidationValueDisplay').textContent = moneyWon(liquidation);
  if(typeof renderRepaymentSummary === 'function' && document.getElementById('repayTotalDebt')) renderRepaymentSummary();
}

