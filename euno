function getMedianIncomeInfo(){
  const raw = getHouseholdSize();
  const clamp = n => Math.min(7, Math.max(1, n));
  const lower = Math.floor(raw);
  const frac = Math.round((raw - lower) * 10) / 10;
  if(frac === 0.5){
    const loSize = clamp(lower), hiSize = clamp(lower + 1);
    const lo = Number(state.income.medianIncome[loSize] || 0);
    const hi = Number(state.income.medianIncome[hiSize] || 0);
    return { size: raw, bracketSize: `${loSize}.5`, median: Math.round((lo + hi) / 2) };
  }
  const size = clamp(Math.ceil(raw));
  return { size: raw, bracketSize: String(size), median: Number(state.income.medianIncome[size] || 0) };
}

let currentExcessCoinBase = 0;

function renderMedianComparison(){
  const note = document.getElementById('medianIncomeNote');
  if(!note) return;
  const info = getMedianIncomeInfo();
  const size = info.bracketSize;
  const median = info.median;
  const isHalfUnit = info.size % 1 === 0.5;
  const roundNote = isHalfUnit
    ? ` (가구원수 ${info.size}인 → ${Math.floor(info.size)}인과 ${Math.floor(info.size)+1}인 기준 중위소득의 평균 적용)`
    : (info.size % 1 !== 0 ? ` (가구원수 ${info.size}인 → ${size}인 기준으로 올림 적용)` : '');

  const monthlyTotal = getIncomeMonthlyTotal();
  const guideEl = document.getElementById('repayGuidelineNote');
  if(guideEl){
    const guideAmount = median ? Math.max(0, monthlyTotal - Math.round(median*0.6)) : 0;
    guideEl.innerHTML = median
      ? `💡 가이드라인: 기준 중위소득 60% 적용 시 예상 변제금은 약 <b>${guideAmount.toLocaleString('ko-KR')}</b>원 입니다.`
      : '';
  }

  const repayment = Number(state.income.expectedRepayment) || 0;
  const derivedLivingExpense = Math.max(0, monthlyTotal - repayment);
  const ratio = median ? (derivedLivingExpense / median) : 0;
  const isOver60 = ratio > 0.6;
  document.getElementById('cardLivingExpenseDetail').style.display = isOver60 ? 'block' : 'none';

  const excessCoinBase = isOver60 ? Math.max(0, derivedLivingExpense - Math.round(median*0.6)) : 0;
  currentExcessCoinBase = excessCoinBase;
  const excessRatioStr = median ? (excessCoinBase/median*100).toFixed(2) : '0.00';
  const coinPanel = document.getElementById('coin-panel');
  if(coinPanel){
    coinPanel.style.display = isOver60 ? 'flex' : 'none';
    const excessRatioEl = document.getElementById('excess-ratio');
    if(excessRatioEl) excessRatioEl.textContent = excessRatioStr;
  }
  const additionalRateInput = document.getElementById('le_additionalRate');
  if(additionalRateInput && isOver60){
    additionalRateInput.value = excessRatioStr;
    state.income.livingExpenseDetail.additionalRate = excessRatioStr;
  }
  updateRemainingCoin();

  if(!repayment || !median){
    note.textContent = `${size}인 가구 기준 중위소득: ${moneyWon(median)}.${roundNote} 월 (예상)변제금을 입력하면 자동 책정된 생계비와 비율이 계산됩니다.`;
    return;
  }
  const pct = (ratio*100).toFixed(1);
  note.innerHTML = `자동 책정된 생계비 ${moneyWon(derivedLivingExpense)}는 ${size}인 가구 기준 중위소득 ${moneyWon(median)}의 약 <b>${pct}%</b>입니다.${roundNote} → <b style="color:${isOver60?'var(--danger)':'var(--ok)'};">${isOver60 ? '60% 초과 (생계비 상세 내역 기재 필요)' : '60% 이하'}</b>`;
}

