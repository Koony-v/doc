function csvEscape(val){
  const s = String(val === undefined || val === null ? '' : val);
  if(/[",\n]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
  return s;
}

function exportCreditorsCSV(){
  const header = ['체크(기본값 F)','채권자목록번호','보증인번호','채권자명','보증인명','도로명주소1(도로명 건물번호까지)','도로명주소2(상세주소)','우편번호','휴대전화번호','전화번호','팩스번호','이메일','차용또는구입일자','발생원인','최초채권액','사용처','잔존원금','잔존이자및지연손해금'];

  const stripCommas = s => (s||'').toString().replace(/,/g, ' ');
  // 우편번호·전화번호처럼 0으로 시작하는 값이 엑셀 등에서 숫자로 잘못 인식되어
  // 앞자리 0이 사라지는 것을 막기 위해, 보이지 않는 탭 문자를 앞에 붙여 문자열로 강제 인식시킴.
  // (엑셀에서 CSV를 직접 열어 검토할 때를 위한 보호장치이며, 전자소송 시스템 자체 업로드에는 영향 없음)
  const preserveLeadingZero = s => {
    const v = stripCommas(s).trim();
    return v ? '\t' + v : '';
  };

  function splitAddress(addr){
    const a = stripCommas(addr).trim();
    if(!a) return ['', ''];
    const idx = a.indexOf('(');
    if(idx > 0) return [a.slice(0, idx).trim(), a.slice(idx).trim()];
    return [a, ''];
  }

  function guessCauseCode(r){
    if(r.natureType === '장래구상채권') return '4';
    const text = `${r.category||''} ${r.note||''}`;
    if(text.includes('카드')) return '2';
    return '1';
  }

  const primaryRows = state.creditors.filter(r => r.name && r.natureType !== '보증채무');
  const guarantorRows = state.creditors.filter(r => r.name && r.natureType === '보증채무' && r.parentId);

  const numberMap = {};
  primaryRows.forEach((r, i) => { numberMap[r.id] = i + 1; });

  const rows = [];
  primaryRows.forEach(r => {
    const [addr1, addr2] = splitAddress(r.address);
    const guarantorChild = guarantorRows.find(g => g.parentId === r.id);
    rows.push([
      'F', numberMap[r.id], '', stripCommas(r.name), guarantorChild ? stripCommas(guarantorChild.name) : '무',
      addr1, addr2, preserveLeadingZero(r.zip), '', preserveLeadingZero(r.phone), '', '',
      r.loanDate || '', guessCauseCode(r),
      r.principal || '0', stripCommas(r.note), r.principal || '0', r.interest || '0'
    ]);
  });
  guarantorRows.forEach(g => {
    const parentNum = numberMap[g.parentId];
    if(!parentNum) return;
    const [addr1, addr2] = splitAddress(g.address);
    rows.push([
      'F', parentNum, '1', stripCommas(g.name), '무',
      addr1, addr2, preserveLeadingZero(g.zip), '', preserveLeadingZero(g.phone), '', '',
      g.loanDate || '미발생', '4',
      '0', stripCommas(g.note) || '장래구상채권', '0', '0'
    ]);
  });

  const csvLines = [header, ...rows].map(row => row.map(csvEscape).join(','));
  const csvContent = '\uFEFF' + csvLines.join('\r\n');
  const blob = new Blob([csvContent], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const nameSlug = (state.debtor.name || '사건').replace(/\s+/g,'');
  a.href = url;
  a.download = `전자소송_채권자목록_${nameSlug}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

function addDays(dateStr, n){
  if(!dateStr) return '';
  const d = new Date(dateStr + 'T00:00:00');
  if(isNaN(d.getTime())) return '';
  d.setDate(d.getDate() + n);
  const y = d.getFullYear();
  const m = String(d.getMonth()+1).padStart(2,'0');
  const dd = String(d.getDate()).padStart(2,'0');
  return `${y}. ${m}. ${dd}.`;
}

function fmtDateKorean(dateStr){
  if(!dateStr) return '';
  const [y,m,d] = dateStr.split('-');
  if(!y || !m || !d) return dateStr;
  return `${y}년 ${Number(m)}월 ${Number(d)}일`;
}

function fmtDateDot(dateStr){
  if(!dateStr) return '';
  const [y,m,d] = dateStr.split('-');
  if(!y || !m || !d) return dateStr;
  return `${y}. ${m}. ${d}.`;
}

