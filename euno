  const medianInfo = getMedianIncomeInfo();
  const size = medianInfo.size;
  const median = medianInfo.median;
  const repayment = Number(inc.expectedRepayment) || 0;
  const planned = Math.max(0, monthlyTotal - repayment);
  const ratio = median ? (planned/median) : 0;
  const isOver60 = ratio > 0.6;
  const led = inc.livingExpenseDetail;
  const fixedTotal = ['food','utilities','furniture','clothing','entertainment','transport','phone','housing','medical','education'].reduce((s,k) => s + (Number(led[k])||0), 0);
  const needsPage2 = isOver60;
