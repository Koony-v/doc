function getAssetLineItems(){
  const a = state.assets;
  const items = [];
  const cash = Number(a.cash)||0;
  if(cash) items.push({key:'cash', label:'현금', amount: cash});

  const depositSum = a.deposits.reduce((s,r) => s + (Number(r.balance)||0), 0);
  const depositNet = Math.max(0, depositSum - 2500000);
  if(depositNet) items.push({key:'depositNet', label:'예금(압류금지 공제후 순액)', amount: depositNet});

  const insuranceSum = a.insurance.reduce((s,r) => s + (Number(r.surrender)||0), 0);
  const insuranceNet = Math.max(0, insuranceSum - 2500000);
  if(insuranceNet) items.push({key:'insuranceNet', label:'보험(압류금지 공제후 순액)', amount: insuranceNet});

  a.leases.forEach(r => {
    const amt = computeLeaseCounted(r);
    if(amt) items.push({key:'lease:'+r.id, label:`임차보증금 - ${r.property||'(물건 미입력)'}`, amount: amt});
  });

  a.vehicles.forEach(r => {
    const p1 = Number(r.price1)||0, p2 = Number(r.price2)||0;
    const avg = (p1 && p2) ? Math.round((p1+p2)/2) : (p1 || p2 || 0);
    const net = Math.max(0, avg - sumLinkedCreditorsCapped(r));
    if(net) items.push({key:'vehicle:'+r.id, label:`자동차 - ${r.plate||r.model||'(정보 미입력)'}`, amount: net});
  });

  a.realties.forEach(r => {
    const amt = Math.max(0, (Number(r.expected)||0) - sumLinkedCreditorsCapped(r));
    if(amt) items.push({key:'realty:'+r.id, label:`부동산 - ${r.location||'(소재지 미입력)'}`, amount: amt});
  });

  a.equipment.forEach(r => {
    const amt = Number(r.value)||0;
    if(amt) items.push({key:'equip:'+r.id, label:`사업용설비 - ${r.items||'(품목 미입력)'}`, amount: amt});
  });

  a.loanReceivables.forEach(r => {
    const amt = Number(r.amount)||0;
    if(amt) items.push({key:'loan:'+r.id, label:`대여금채권 - ${r.debtor||'(상대방 미입력)'}`, amount: amt});
  });

  a.salesReceivables.forEach(r => {
    const amt = Number(r.amount)||0;
    if(amt) items.push({key:'sales:'+r.id, label:`매출금채권 - ${r.debtor||'(상대방 미입력)'}`, amount: amt});
  });

  if(!a.severance.isPension){
    const severanceNet = Math.round((Number(a.severance.total)||0) / 2);
    if(severanceNet) items.push({key:'severanceNet', label:'예상퇴직금(압류금지 공제후 순액)', amount: severanceNet});
  }

  a.others.forEach(r => {
    const amt = Number(r.value)||0;
    if(amt) items.push({key:'other:'+r.id, label:`기타재산 - ${r.label||'(항목명 미입력)'}`, amount: amt});
  });

  return items;
}

