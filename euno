function normalizeCreditorName(s){
  return (s || '').replace(/\(주\)|\(유\)|㈜|\s+/g, '').trim();
}
const CREDITOR_NORM_MAP = new Map(CREDITOR_DB.map(c => [normalizeCreditorName(c.name), c]));
function findCreditor(name){
  const trimmed = (name || '').trim();
  if(!trimmed) return null;
  return CREDITOR_MAP.get(trimmed) || CREDITOR_NORM_MAP.get(normalizeCreditorName(trimmed)) || null;
}

