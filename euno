    <tr><td class="rlabel">해약반환금</td>${group.map(r => `<td style="text-align:right;">${a.insurance.length ? (Number(r.surrender)||0).toLocaleString('ko-KR')+'원' : '-'}</td>`).join('')}${padCells(pad)}</tr>`;
  }).join('') + `
    <tr><td colspan="${remarkColspan}" style="text-align:center;color:#555;">250만원 이하의 해약환급금은 압류금지채권</td></tr>`;
  function vehicleDeductionInfo(r){
    const linkedIds = r.linkedCreditorIds || [];
    if(!linkedIds.length) return null;
    let anyCapped = false;
    const total = linkedIds.reduce((s,cid) => {
      const c = state.creditors.find(x => x.id === cid);
      if(!c) return s;
      const debtBalance = (Number(c.principal)||0) + (Number(c.interest)||0);
      const maxClaim = (c.hasAttachment && c.attachmentType === '1' && c.attachmentType1 && Number(c.attachmentType1.amount)) ? Number(c.attachmentType1.amount) : null;
      const used = maxClaim ? Math.min(debtBalance, maxClaim) : debtBalance;
      if(maxClaim && maxClaim < debtBalance) anyCapped = true;
      return s + used;
    }, 0);
    return { total, label: anyCapped ? '채권최고액' : '잔존채무' };
