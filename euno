  const body = document.getElementById('stmtCareerBody');
  body.innerHTML = rows.map(row => `
    <tr>
      <td><input type="text" data-id="${row.id}" data-field="periodStart" value="${escapeHtml(fmtDateInputDisplay(row.periodStart))}" placeholder="26/1/1"></td>
      <td><input type="text" data-id="${row.id}" data-field="periodEnd" value="${escapeHtml(fmtDateInputDisplay(row.periodEnd))}" placeholder="현재까지" ${row.isCurrent?'disabled':''}></td>
      <td style="text-align:center;"><input type="checkbox" data-id="${row.id}" data-field="isCurrent" ${row.isCurrent?'checked':''} style="width:auto;"></td>
      <td><input type="text" data-id="${row.id}" data-field="businessType" value="${escapeHtml(row.businessType)}" placeholder="업종"></td>
      <td><input type="text" data-id="${row.id}" data-field="workplace" value="${escapeHtml(row.workplace)}" placeholder="직장명"></td>
      <td><input type="text" data-id="${row.id}" data-field="position" value="${escapeHtml(row.position)}" placeholder="직위"></td>
      <td><select data-id="${row.id}" data-field="natureType">
        <option value="근무" ${row.natureType==='근무'?'selected':''}>근무</option>
        <option value="자영" ${row.natureType==='자영'?'selected':''}>자영</option>
      </select></td>
      <td><button class="del-row" data-id="${row.id}" title="삭제">✕</button></td>
