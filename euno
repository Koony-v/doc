function bindIncome(){
  document.getElementById('btnPrintIncomeExpense').addEventListener('click', printIncomeExpense);
  document.getElementById('panel-income').addEventListener('keydown', e => {
    if(e.key !== 'Enter') return;
    if(e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT'){
      e.preventDefault();
      e.target.blur();
    }
  });

  document.getElementById('incomeSourceBody').addEventListener('input', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id || !field) return;
    const row = state.income.sources.find(r => r.id === id);
    if(!row) return;
    if(field === 'monthlyAmount'){
      row.monthlyAmount = liveFormatMoney(t);
      renderIncomeSummary();
    } else if(field === 'extra'){
      row.extra = t.value;
    } else {
      row[field] = t.value;
    }
    save();
  });
  document.getElementById('incomeSourceBody').addEventListener('change', e => {
    const t = e.target;
    const id = t.dataset.id, field = t.dataset.field;
    if(!id) return;
    const row = state.income.sources.find(r => r.id === id);
    if(!row) return;
    if(field === 'extra'){
      const raw = t.value.trim();
      if(!raw){ row.extra = ''; t.classList.remove('date-error'); renderIncomeSources(); save(); return; }
      const parsed = parseFlexibleDate(raw);
      if(parsed === null){ t.classList.add('date-error'); save(); return; }
      row.extra = parsed;
      t.classList.remove('date-error');
      renderIncomeSources();
      save();
      return;
    }
    if(t.tagName !== 'SELECT') return;
    row[field] = t.value;
    if(field === 'type') row.extra = '';
    renderIncomeSources();
    save();
  });
  document.getElementById('incomeSourceBody').addEventListener('click', e => {
    const btn = e.target.closest('.del-row');
    if(!btn) return;
    state.income.sources = state.income.sources.filter(r => r.id !== btn.dataset.id);
    renderIncomeSources();
    renderIncomeSummary();
    save();
  });
  document.getElementById('btnAddIncomeSource').addEventListener('click', () => {
    state.income.sources.push(newIncomeSourceRow());
    renderIncomeSources();
    save();
  });

  const bindMoney = (id, obj, key) => {
    document.getElementById(id).addEventListener('input', e => {
      obj[key] = liveFormatMoney(e.target);
      renderIncomeSummary();
      save();
    });
  };
  const bindText = (id, obj, key, after) => {
    document.getElementById(id).addEventListener('input', e => {
      obj[key] = e.target.value;
      if(after) after();
      save();
    });
  };

  for(let i=1;i<=7;i++){
    const el = document.getElementById('median'+i);
    if(!el) continue;
    el.addEventListener('input', e => {
      state.income.medianIncome[i] = liveFormatMoney(e.target);
      renderMedianComparison();
      renderIncomeSummary();
      save();
    });
  }

  document.getElementById('householdSize').addEventListener('input', e => {
    let v = e.target.value.replace(/[^\d.]/g,'');
    const firstDot = v.indexOf('.');
    if(firstDot !== -1){
      v = v.slice(0, firstDot+1) + v.slice(firstDot+1).replace(/\./g,'');
    }
    state.income.householdSize = v;
    e.target.value = v;
    renderMedianComparison();
    renderIncomeSummary();
    save();
  });

  document.getElementById('expectedRepayment').addEventListener('input', e => {
    state.income.expectedRepayment = liveFormatMoney(e.target);
    renderMedianComparison();
    renderIncomeSummary();
    save();
  });

  ['food','utilities','furniture','clothing','entertainment','transport','phone','housing','medical','education'].forEach(k => {
    document.getElementById('le_'+k).addEventListener('input', e => {
      state.income.livingExpenseDetail[k] = liveFormatMoney(e.target);
      updateRemainingCoin();
      renderIncomeSummary();
      save();
    });
  });
  bindText('le_additionalReason', state.income.livingExpenseDetail, 'additionalReason');
  // le_additionalRate는 readonly이며 renderMedianComparison()의 자동계산 로직으로만 갱신됩니다.

  document.getElementById('familyIncomeBody').addEventListener('input', e => {
    const t = e.target;
    const fid = t.dataset.fid, field = t.dataset.field;
    if(!fid || !field) return;
    if(field === 'livesTogether' || field === 'isDependent'){
      const familyRow = state.family.find(r => r.id === fid);
      if(familyRow){
        familyRow[field] = t.checked;
        if(field === 'livesTogether'){
          familyRow.livingPeriod = t.checked ? '동거중' : '별거중';
        }
        renderHouseholdSize();
        renderIncomeFamilyTable();
        if(typeof renderFamily === 'function' && document.getElementById('familyBody')) renderFamily();
      }
      save();
      return;
    }
    if(field === 'livingPeriod' || field === 'job'){
      const familyRow = state.family.find(r => r.id === fid);
      if(familyRow) familyRow[field] = t.value;
      if(typeof renderFamily === 'function' && document.getElementById('familyBody')) renderFamily();
      save();
      return;
    }
    if(!state.income.familyIncome[fid]) state.income.familyIncome[fid] = { monthlyIncome:'', totalAssets:'' };
    state.income.familyIncome[fid][field] = liveFormatMoney(t);
    save();
  });
}

