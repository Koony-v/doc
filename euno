function bindBasicInputs(){
  document.getElementById('court').addEventListener('input', e => { state.court = e.target.value; renderSummary(); save(); });
  document.getElementById('caseNumber').addEventListener('input', e => { state.caseNumber = e.target.value; save(); });
  document.getElementById('courtDivision').addEventListener('input', e => { state.courtDivision = e.target.value; save(); });
  document.getElementById('repayStartDate').addEventListener('input', e => { state.repayStartDate = e.target.value; save(); });
  document.getElementById('bankName').addEventListener('input', e => { state.bankName = e.target.value; save(); });
  document.getElementById('bankAccount').addEventListener('input', e => { state.bankAccount = e.target.value; save(); });
  document.getElementById('repayBankName').addEventListener('input', e => { state.repayBankName = e.target.value; save(); });
  document.getElementById('repayBankAccount').addEventListener('input', e => { state.repayBankAccount = e.target.value; save(); });

  const caseDateFields = [['filingDate','filingDate'], ['commencementDate','commencementDate'], ['confirmationDate','confirmationDate']];
  caseDateFields.forEach(([elId, stateKey]) => {
    const el = document.getElementById(elId);
    el.addEventListener('change', e => {
      const raw = e.target.value.trim();
      if(!raw){ state[stateKey] = ''; e.target.classList.remove('date-error'); renderRepayStartHint(); save(); return; }
      const parsed = parseFlexibleDate(raw);
      if(parsed === null){ e.target.classList.add('date-error'); save(); return; }
      state[stateKey] = parsed;
      e.target.value = fmtDateInputDisplay(parsed);
      e.target.classList.remove('date-error');
      renderRepayStartHint();
      save();
    });
  });
  document.getElementById('draftDate').addEventListener('input', e => { state.draftDate = e.target.value; save(); });
  document.getElementById('debtorName').addEventListener('input', e => { state.debtor.name = e.target.value; save(); });
  document.getElementById('debtorRRN').addEventListener('input', e => { state.debtor.rrn = e.target.value; save(); });
  document.getElementById('debtorPhone').addEventListener('input', e => { state.debtor.phone = e.target.value; save(); });
  document.getElementById('debtorRegAddr').addEventListener('input', e => {
    state.debtor.regAddress = e.target.value;
    if(state.debtor.sameAsReg){
      document.getElementById('debtorCurrentAddr').value = e.target.value;
    }
    save();
  });
  document.getElementById('debtorCurrentAddr').addEventListener('input', e => { state.debtor.currentAddress = e.target.value; save(); });
  document.getElementById('debtorZip').addEventListener('input', e => { state.debtor.zip = e.target.value; save(); });
  document.getElementById('sameAddr').addEventListener('change', e => {
    state.debtor.sameAsReg = e.target.checked;
    if(e.target.checked){ state.debtor.currentAddress = state.debtor.regAddress; }
    renderBasic();
    save();
  });

  document.getElementById('procedureToggle').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if(!btn) return;
    state.procedureType = btn.dataset.val;
    renderBasic();
    save();
  });

  document.getElementById('btnPostcode').addEventListener('click', () => {
    if(typeof daum === 'undefined' || !daum.Postcode){
      alert('우편번호 검색 서비스를 불러오지 못했습니다. 인터넷 연결을 확인해주세요.');
      return;
    }
    new daum.Postcode({
      oncomplete: function(data){
        const fullAddress = data.roadAddress || data.jibunAddress;
        state.debtor.zip = data.zonecode;
        state.debtor.regAddress = fullAddress;
        if(state.debtor.sameAsReg){
          state.debtor.currentAddress = fullAddress;
        }
        renderBasic();
        save();
      }
    }).open();
  });
}

