  const vehicleRowsHtml = vehicleBlockRows(vehicleList[0], vehicleRowspanCells) + vehicleList.slice(1).map(r => vehicleBlockRows(r)).join('');

  const leaseReasonLabels = {'해당없음':'해당없음(전액 반영)', '246조6호':'제246조1항6호(지역별 공제)', '반환불가':'반환·회수 곤란(직접입력)', '질권설정':'질권설정(채권목록 연동)'};
  const leaseValueSpan = Math.max(1, remarkColspan - 1);
  function leaseBlockRows(r, extraCells){
