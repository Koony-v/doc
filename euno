    if(!tr || tr.dataset.rowId === familyDragState.id) return;
    tbody.querySelectorAll('tr').forEach(row => row.classList.remove('drop-before','drop-after'));
    const rect = tr.getBoundingClientRect();
    const relY = (e.clientY - rect.top) / rect.height;
    const zone = relY < 0.5 ? 'before' : 'after';
    tr.dataset.dropZone = zone;
    tr.classList.add('drop-' + zone);
  });

  tbody.addEventListener('drop', e => {
    e.preventDefault();
    const tr = e.target.closest('tr');
    const zone = tr ? tr.dataset.dropZone : null;
    tbody.querySelectorAll('tr').forEach(row => row.classList.remove('drop-before','drop-after'));
    if(!tr || !familyDragState) return;
    const targetId = tr.dataset.rowId;
    const draggedId = familyDragState.id;
    familyDragState = null;
    if(targetId === draggedId) return;

    const fromIdx = state.family.findIndex(r => r.id === draggedId);
    if(fromIdx === -1) return;
    const [dragged] = state.family.splice(fromIdx, 1);
    let targetIdx = state.family.findIndex(r => r.id === targetId);
    if(targetIdx === -1){ state.family.splice(fromIdx, 0, dragged); return; }
    const insertIdx = targetIdx + (zone === 'after' ? 1 : 0);
    state.family.splice(insertIdx, 0, dragged);

    renderFamily();
    renderIncomeFamilyTable();
    save();
  });
}

