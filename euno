  if(!input) return '';
  const trimmed = input.trim();
  let y, m, d;
  const sepMatch = trimmed.match(/^(\d{2,4})\s*[.\-/]\s*(\d{1,2})\s*[.\-/]\s*(\d{1,2})\.?\s*$/);
  if(sepMatch){
    const yy = sepMatch[1];
    y = yy.length <= 2 ? (Number(yy) >= 50 ? 1900 + Number(yy) : 2000 + Number(yy)) : Number(yy);
    m = Number(sepMatch[2]);
    d = Number(sepMatch[3]);
  } else {
    const digits = trimmed.replace(/[^0-9]/g, '');
    if(digits.length === 6){
      const yy = parseInt(digits.slice(0,2), 10);
      y = yy >= 50 ? 1900 + yy : 2000 + yy;
      m = parseInt(digits.slice(2,4), 10);
      d = parseInt(digits.slice(4,6), 10);
    } else if(digits.length === 8){
      y = parseInt(digits.slice(0,4), 10);
      m = parseInt(digits.slice(4,6), 10);
      d = parseInt(digits.slice(6,8), 10);
    } else {
      return null;
    }
  }
  if(!m || !d || m < 1 || m > 12 || d < 1 || d > 31) return null;
  const mm = String(m).padStart(2,'0');
  const dd = String(d).padStart(2,'0');
  return `${y}-${mm}-${dd}`;
}

function fmtDateInputDisplay(dateStr){
  if(!dateStr) return '';
  const parts = dateStr.split('-');
  if(parts.length !== 3) return dateStr;
  const [y, m, d] = parts;
  if(!y || !m || !d) return dateStr;
  return `${y}. ${Number(m)}. ${Number(d)}.`;
}

function todayISO(){
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth()+1).padStart(2,'0');
  const day = String(d.getDate()).padStart(2,'0');
  return `${y}-${m}-${day}`;
}

function addMonthsISO(isoDate, months){
  const [y, m, d] = isoDate.split('-').map(Number);
  const dt = new Date(y, m-1, d);
  dt.setMonth(dt.getMonth() + months);
  const yy = dt.getFullYear();
  const mm = String(dt.getMonth()+1).padStart(2,'0');
  const dd = String(dt.getDate()).padStart(2,'0');
  return `${yy}-${mm}-${dd}`;
}

function fmtDateDotTight(isoDate){
  const [y,m,d] = isoDate.split('-');
  return `${y}.${String(m).padStart(2,'0')}.${String(d).padStart(2,'0')}`;
}

