function computeDisplayNumbers(){
  const ids = new Set(state.creditors.map(r => r.id));
  state.creditors.forEach(r => {
    if(r.parentId && !ids.has(r.parentId)) r.parentId = null;
  });
  const numbers = {};
  const branchCounters = {};
  let counter = 0;
  state.creditors.forEach(row => {
    if(row.parentId && numbers[row.parentId]){
      branchCounters[row.parentId] = (branchCounters[row.parentId] || 0) + 1;
      numbers[row.id] = `${numbers[row.parentId]}-${branchCounters[row.parentId]}`;
    } else {
      row.parentId = null;
      counter += 1;
      numbers[row.id] = String(counter);
    }
  });
  return numbers;
}

