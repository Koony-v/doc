let housingDragState = null;
function bindHousingDragDrop(){
  const tbody = document.getElementById('housingBody');

  tbody.addEventListener('dragstart', e => {
    const handle = e.target.closest('.drag-handle');
    if(!handle){ e.preventDefault(); return; }
    housingDragState = { id: handle.dataset.id };
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', handle.dataset.id);
    const tr = handle.closest('tr');
    if(tr) tr.style.opacity = '0.4';
  });

  tbody.addEventListener('dragend', e => {
    const tr = e.target.closest('tr');
    if(tr) tr.style.opacity = '';
    tbody.querySelectorAll('tr').forEach(row => row.classList.remove('drop-before','drop-after'));
    housingDragState = null;
  });

  tbody.addEventListener('dragover', e => {
    if(!housingDragState) return;
    e.preventDefault();
    const tr = e.target.closest('tr');
    if(!tr || tr.dataset.rowId === housingDragState.id) return;
    tbody.querySelectorAll('tr').forEach(row => row.classList.remove('drop-before','drop-after'));
    const rect = tr.getBoundingClientRect();
    const relY = (e.clientY - rect.top) / rect.height;
    const zone = relY < 0.5 ? 'before' : 'after';
    tr.dataset.dropZone = zone;
    tr.classList.add('drop-' + zone);
  });

  tbody.addEventListener('drop', e => {
    e.preventDefault();
    const tr = e.target.closest('tr');
    const zone = tr ? tr.dataset.dropZone : null;
    tbody.querySelectorAll('tr').forEach(row => row.classList.remove('drop-before','drop-after'));
    if(!tr || !housingDragState) return;
    const targetId = tr.dataset.rowId;
    const draggedId = housingDragState.id;
    housingDragState = null;
    if(targetId === draggedId) return;

    const fromIdx = state.housing.findIndex(r => r.id === draggedId);
    if(fromIdx === -1) return;
    const [dragged] = state.housing.splice(fromIdx, 1);
    let targetIdx = state.housing.findIndex(r => r.id === targetId);
    if(targetIdx === -1){ state.housing.splice(fromIdx, 0, dragged); return; }
    const insertIdx = targetIdx + (zone === 'after' ? 1 : 0);
    state.housing.splice(insertIdx, 0, dragged);

    renderHousing();
    save();
  });
}

