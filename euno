  function fmtDateDotFull(iso){
    if(!iso) return '';
    const [y,m,d] = iso.split('-');
    if(!y||!m||!d) return '';
    return `${y}.${String(m).padStart(2,'0')}.${String(d).padStart(2,'0')}.`;
  }
  function formatExperienceDurationCell(startISO){
    const dur = computeExperienceDuration(startISO);
    return (dur && startISO) ? `약 ${dur}` : '&nbsp;';
  }
  function formatExperienceStartDateCell(startISO){
    const dateStr = fmtDateDotFull(startISO);
    return dateStr ? `${dateStr} ~ 현재` : '&nbsp;';
  }

  const incomeGroups = inc.sources.map(src => {
    const durationText = formatExperienceDurationCell(src.extra);
    const startDateText = formatExperienceStartDateCell(src.extra);
    if(src.type === 'selfEmployed'){
      return {
        selfBiz: escapeHtml(src.name)||'&nbsp;',
        selfType: escapeHtml(src.title)||'&nbsp;',
        selfExp: durationText,
        empName:'&nbsp;', empPos:'&nbsp;', empPeriod: startDateText
      };
    }
    return {
      selfBiz:'&nbsp;', selfType:'&nbsp;',
      selfExp: durationText,
      empName: escapeHtml(src.name)||'&nbsp;',
      empPos: escapeHtml(src.title)||'&nbsp;',
      empPeriod: startDateText
