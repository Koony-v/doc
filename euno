function printAssetList(){
  const a = state.assets;
  const cash = Number(a.cash)||0;
  const depositSum = a.deposits.reduce((s,r)=>s+(Number(r.balance)||0),0);
  const depositNet = Math.max(0, depositSum-2500000);
  const insuranceSum = a.insurance.reduce((s,r)=>s+(Number(r.surrender)||0),0);
  const insuranceNet = Math.max(0, insuranceSum-2500000);
  const vehicleTotal = a.vehicles.reduce((s,r)=>{const p1=Number(r.price1)||0,p2=Number(r.price2)||0;const avg=(p1&&p2)?Math.round((p1+p2)/2):(p1||p2||0);return s+Math.max(0,avg-sumLinkedCreditorsCapped(r));},0);
  const leaseTotal = a.leases.reduce((s,r)=>s+computeLeaseCounted(r),0);
  const realtyTotal = a.realties.reduce((s,r)=>s+Math.max(0,(Number(r.expected)||0)-sumLinkedCreditorsCapped(r)),0);
  const equipTotal = a.equipment.reduce((s,r)=>s+(Number(r.value)||0),0);
  const loanReceivableSum = a.loanReceivables.reduce((s,r)=>s+(Number(r.amount)||0),0);
  const salesReceivableSum = a.salesReceivables.reduce((s,r)=>s+(Number(r.amount)||0),0);
  const severanceNet = a.severance.isPension ? 0 : Math.round((Number(a.severance.total)||0)/2);
  const otherTotal = a.others.reduce((s,r)=>s+(Number(r.value)||0),0);
  const total = cash+depositNet+insuranceNet+vehicleTotal+leaseTotal+realtyTotal+equipTotal+loanReceivableSum+salesReceivableSum+severanceNet+otherTotal;
  const exemption = getExemptionTotal();
  const liquidation = Math.max(0, total-exemption);

  const remarkCols = 3;
  const remarkColspan = remarkCols + 1;
  const padCells = n => n > 0 ? Array(n).fill('<td></td>').join('') : '';
  const chunk = (arr, size) => { const out=[]; for(let i=0;i<arr.length;i+=size) out.push(arr.slice(i,i+size)); return out; };

  const depositChunks = chunk(a.deposits.length ? a.deposits : [{bank:'', account:'', balance:0}], remarkCols);
  const depositTotalRows = depositChunks.length * 3;
  const depositRowsHtml = depositChunks.map((group, gi) => {
    const pad = remarkCols - group.length;
    const rowspanCells = gi === 0 ? `
      <td rowspan="${depositTotalRows}">예금</td>
      <td rowspan="${depositTotalRows}" style="text-align:right;">${depositNet.toLocaleString('ko-KR')}</td>
      <td rowspan="${depositTotalRows}" style="text-align:center;">무</td>` : '';
    return `
    <tr>${rowspanCells}
      <td class="rlabel">금융기관명</td>${group.map(r => `<td>${escapeHtml(r.bank)||'-'}</td>`).join('')}${padCells(pad)}
    </tr>
    <tr><td class="rlabel">계좌번호</td>${group.map(r => `<td>${escapeHtml(r.account)||'-'}</td>`).join('')}${padCells(pad)}</tr>
    <tr><td class="rlabel">잔고</td>${group.map(r => `<td style="text-align:right;">${a.deposits.length ? (Number(r.balance)||0).toLocaleString('ko-KR')+'원' : '-'}</td>`).join('')}${padCells(pad)}</tr>`;
  }).join('');

  const insuranceChunks = chunk(a.insurance.length ? a.insurance : [{company:'', policyNo:'', surrender:0}], remarkCols);
  const insuranceTotalRows = insuranceChunks.length * 3 + 1;
  const insuranceRowsHtml = insuranceChunks.map((group, gi) => {
    const pad = remarkCols - group.length;
    const rowspanCells = gi === 0 ? `
      <td rowspan="${insuranceTotalRows}">보험</td>
      <td rowspan="${insuranceTotalRows}" style="text-align:right;">${insuranceNet.toLocaleString('ko-KR')}</td>
