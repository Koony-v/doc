function computeRepaymentSchedule(){
  const rp = state.repaymentPlan;
  const availableIncomeText = document.getElementById('sumAvailableIncome') ? document.getElementById('sumAvailableIncome').textContent : '0원';
  const monthlyAvailable = Number((availableIncomeText||'').replace(/[^\d]/g,'')) || 0;
  const months = Number(rp.months) || 36;

  const rows = state.creditors.filter(c => c.name).map(c => {
    const isFuture = c.natureType === '장래구상채권';
    const amount = isFuture ? 0 : (Number(c.principal)||0) + (Number(c.interest)||0);
    return { id: c.id, name: c.name, claimType: c.claimType, amount, isFuture };
  });
  const totalDebt = rows.reduce((s,r) => s + r.amount, 0);

  rows.forEach(r => {
    if(r.isFuture || totalDebt === 0){
      r.monthly = 0;
      r.total = 0;
    } else {
      r.monthly = Math.ceil((r.amount / totalDebt) * monthlyAvailable / 10) * 10;
      r.total = r.monthly * months;
    }
  });

  const totalMonthly = rows.reduce((s,r) => s + r.monthly, 0);
  const totalRepay = rows.reduce((s,r) => s + r.total, 0);
  const repayRate = totalDebt ? (totalRepay / totalDebt * 100) : 0;

  return { rows, totalDebt, totalMonthly, totalRepay, repayRate, monthlyAvailable, months };
}

